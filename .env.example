# Bucketick — build-time env (Vite bakes VITE_* at build time; rebuild to change)

# Backend base URL. No backend yet — api-client runs on stub() data until this
# points somewhere real.
VITE_API_URL=http://localhost:8090

# Analytics (optional)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com
