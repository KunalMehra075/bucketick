# Bucketick API environment

# The MongoDB connection string. Paste yours here in a copy named `.env`.
# Example (Atlas): mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/bucketick?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/bucketick

# Port the API listens on. The frontend defaults to talking to :8090.
PORT=8090

# JWT secrets. Use long random strings in production (openssl rand -hex 32).
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me

# Token lifetimes.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Comma-separated allowed origins for CORS (web apps). Mobile does not need this.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
