{
  "expo": {
    "name": "Bucketick",
    "slug": "bucketick-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bucketick",
    "userInterfaceStyle": "light",
    "backgroundColor": "#fffdf8",
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#fffdf8",
      "bundleIdentifier": "com.bucketick.app"
    },
    "android": {
      "package": "com.bucketick.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fffdf8"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#fffdf8"
        }
      ],
      "expo-image"
    ]
  }
}
