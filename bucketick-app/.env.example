# Copy to .env to point the app at your backend.
# Expo inlines any EXPO_PUBLIC_* variable at build time.
#
#   iOS simulator:      http://localhost:8090
#   Android emulator:   http://10.0.2.2:8090
#   Physical device:    http://<your-computer-LAN-IP>:8090  (e.g. 192.168.1.20)
#
# If unset, the app defaults to http://localhost:8090.
EXPO_PUBLIC_API_URL=http://localhost:8090
